SELECT c.*
FROM clientes c
LEFT JOIN pedidos p ON c.id = p.cliente_id
WHERE p.id IS NULL;

SELECT cliente_id, COUNT(*) AS quantidade_pedidos
FROM pedidos
GROUP BY cliente_id;

SELECT cliente_id, SUM(valor) AS total_gasto
FROM pedidos
GROUP BY cliente_id;

SELECT cliente_id, COUNT(*) AS qtd
FROM pedidos
GROUP BY cliente_id
HAVING COUNT(cliente_id) > 1;

